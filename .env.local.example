# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite file path — no changes needed for local use
DATABASE_URL="file:./prisma/dev.db"

# ─── eBay API ──────────────────────────────────────────────────────────────────
# 1. Go to https://developer.ebay.com and sign in with your eBay account
# 2. Click "Get Application Keys" → create a new Keyset (Production)
# 3. Copy the "App ID (Client ID)" value here
EBAY_APP_ID="YOUR_EBAY_APP_ID_HERE"

# ─── Gmail (email alerts) ──────────────────────────────────────────────────────
# Use an App Password, NOT your regular Gmail password.
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification if not already on
# 3. Search for "App passwords" → create one for "Mail"
# 4. Paste the 16-character password below (no spaces)
GMAIL_USER="sharatvikas@gmail.com"
GMAIL_APP_PASSWORD="YOUR_16_CHAR_APP_PASSWORD_HERE"

# Where to send alert emails (can be any email)
NOTIFICATION_EMAIL="sharatvikas@gmail.com"

# ─── Claude API (card image identification) ───────────────────────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-YOUR_KEY_HERE"

# ─── App URL ───────────────────────────────────────────────────────────────────
# Change only if you run the app on a different port
NEXT_PUBLIC_APP_URL="http://localhost:3000"
